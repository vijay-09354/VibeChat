generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())

  conversationsStarted  Conversation[] @relation("ConversationStarter")
  conversationsReceived Conversation[] @relation("ConversationReceiver")
  messages              Message[]
}

model Conversation {
  id         Int      @id @default(autoincrement())
  starterId  Int
  receiverId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  starter  User @relation("ConversationStarter", fields: [starterId], references: [id])
  receiver User @relation("ConversationReceiver", fields: [receiverId], references: [id])

  messages Message[]

  @@unique([starterId, receiverId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String   @default("")
  
  mediaUrl       String?
  mediaType      String?
  fileName       String?
  
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User @relation(fields: [senderId], references: [id])
}